{
    "fallbackRetryDelay": "5000ms",
    "ignorePatterns" : [
        {
            "pattern": "localhost"
        },
        {
            "pattern": "127.0.0.1"
        },
        {
          "pattern": "^https://confluenceent.cms.gov"
        },
        {
          "pattern": "^https://jiraent.cms.gov"
        },
        {
          "pattern": "^https://www.hhs.gov"
        },
        {
          "pattern": "^https://medium.com/interleap/terraform-destroy-replace-buckets-cf9d63d0029d$"
        },
        {
          "pattern": "^https://([^.]+\\.)*your-agency\\.gov"
        },
        {
          "pattern": "^https://hhs.responsibledisclosure.com/$"
        },
        {
          "pattern": "^https://github.com/DSACMS/iv-cbv-payroll/pull/([\\d]+)$"
        },
        {
          "pattern": "^https://github.com/CMS-Enterprise/emmy-app/pull/([\\d]+)$"
        }
    ],
    "replacementPatterns": [
        {
            "pattern": "^/",
            "replacement": "{{BASEURL}}/"
        }
    ],
    "retryCount": 3,
    "retryOn429": true
}
