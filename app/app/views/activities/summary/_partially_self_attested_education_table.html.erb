<% enrollment_terms = activity.nsc_enrollment_terms.order(:term_begin, :term_end, :school_name) %>
<% first_term = enrollment_terms.first %>
<% student_name = [ first_term&.first_name, first_term&.middle_name, first_term&.last_name ].compact_blank.join(" ").presence || t("shared.not_applicable") %>
<% education_information = t("shared.table_headers.education_information") %>

<h3><%= t("activities.summary.education.enrollment_details") %></h3>

<% rows = [
  { label: t("activities.summary.education.type"), value: activity.education_type_display },
  { label: t("components.enrollment_term_table_component.student_name_label"), value: student_name }
] %>
<% rows += enrollment_terms.map(&:school_name).uniq.map do |school_name|
  { label: t("components.enrollment_term_table_component.school_or_program"), value: school_name.to_s.titlecase }
end %>
<%= render ContactInfoReviewTableComponent.new(
  field_header: education_information,
  value_header: t("shared.table_headers.your_details"),
  rows: rows
) %>

<%= render "activities/summary/education_term_table", activity: activity, term_groups: enrollment_terms.map { |term| [ term ] } %>
