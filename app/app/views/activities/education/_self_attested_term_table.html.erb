<% enrollment_status_label = local_assigns[:self_attested_labels] ? t("activities.education.review.enrollment_status_self_attested") : t("activities.education.add_your_term.edit.enrollment_status") %>
<% credit_hours_label = local_assigns[:self_attested_labels] ? t("activities.education.review.credit_hours_self_attested") : t("activities.education.review.credit_hours") %>
<% rows = [
  { label: enrollment_status_label, value: activity.self_attested_enrollment_status_display },
  { label: t("activities.education.add_your_term.edit.term_start"), value: format_date(activity.self_attested_term_start, :month_year) },
  { label: t("activities.education.add_your_term.edit.term_end"), value: format_date(activity.self_attested_term_end, :month_year) }
] %>
<% if activity.self_attested_credit_hours_applicable? && activity.credit_hours.present? %>
  <% rows << { label: credit_hours_label, value: format_decimal_amount(activity.credit_hours) } %>
<% end %>

<%= render ContactInfoReviewTableComponent.new(
  field_header: t("shared.table_headers.education_information"),
  value_header: t("shared.table_headers.your_details"),
  rows: rows
) %>
