<footer class="cbv-footer">
  <div class="cbv-footer__content grid-row desktop:display-flex desktop:flex-justify">
    <div class="cbv-footer__item grid-col-12 tablet:grid-col-8">
      <% if activity_flow? %>
        <div class="cbv-footer__logo-text">
          <strong class="cbv-footer__logo-line1"><%= t("shared.pilot_name_hr1_footer_line1") %></strong>
          <span class="cbv-footer__logo-line2"><%= t("shared.pilot_name_hr1") %></span>
        </div>
      <% else %>
        <div class="display-table-cell text-middle height-5">
          <strong><%= t("shared.pilot_name") %></strong>
        </div>
      <% end %>
    </div>
    <div class="cbv-footer__item cbv-footer__feedback grid-col-12 tablet:grid-col-4 desktop:display-flex desktop:flex-justify-end">
      <%= render LinkWithIconComponent.new(
        t("shared.footer.feedback"),
        url: feedbacks_path(referer: request.original_url),
        icon: "forum",
        class: "usa-button usa-button--outline usa-button--inverse maxw-mobile margin-right-0",
        target: "_blank"
      ) %>
    </div>

    <div class="cbv-footer__item cbv-footer__links grid-col-12 margin-top-0 margin-bottom-0">
      <ul class="usa-list usa-list--unstyled desktop:display-flex">
        <li class="margin-bottom-1 desktop:margin-bottom-0 desktop:margin-right-3">
          <%= link_to t("shared.footer.privacy_policy"), "https://www.cms.gov/medicaid-chip/community-engagement-support/eligibility-made-easy-emmy/emmy-privacy-policy", target: "_blank", rel: "noopener noreferrer" %>
        </li>
        <li>
          <%= link_to t("shared.footer.terms_of_service"), "https://cms.gov/medicaid-chip/community-engagement-support/eligibility-made-easy-emmy/emmy-sample-terms-service-agreement", target: "_blank", rel: "noopener noreferrer" %>
        </li>
      </ul>
    </div>

    <% if activity_flow? %>
      <%= render "application/footer_partner" %>
    <% end %>
  </div>
</footer>
