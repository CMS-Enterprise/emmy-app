<%# Shared USWDS modal shell. The caller supplies the body and footer. %>
<div class="usa-modal shared-modal"
     id="<%= id %>"
     aria-labelledby="<%= heading_id %>"
     aria-describedby="<%= description_id %>">
  <div class="usa-modal__content">
    <div class="usa-modal__main desktop:padding-top-0">
      <h2 class="usa-modal__heading" id="<%= heading_id %>">
        <%= heading %>
      </h2>
      <%= yield %>
    </div>
    <button type="button"
            class="usa-button usa-modal__close"
            aria-label="<%= close_label %>"
            data-close-modal>
      <svg class="usa-icon" aria-hidden="true" focusable="false">
        <use href="<%= uswds_sprite_icon_href("close") %>"></use>
      </svg>
    </button>
  </div>
</div>
